{
  "name": "monaco-gherkin-root",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@monaco-gherkin/web",
    "build": "npm run build --workspace=@monaco-gherkin/web",
    "extract": "npm run extract --workspace=@monaco-gherkin/cucumber-java",
    "electron:dev": "npm run dev --workspace=monaco-gherkin-electron",
    "electron:build": "npm run build --workspace=monaco-gherkin-electron"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.0",
    "concurrently": "^8.0.0",
    "cross-env": "^7.0.3",
    "typescript": "^5.9.3"
  },
  "build": {
    "appId": "com.example.monacogherkin",
    "productName": "Monaco Gherkin",
    "directories": {
      "output": "dist_electron"
    },
    "files": [
      "apps/web/dist/**/*",
      "apps/electron/**/*",
      "packages/*/package.json",
      "packages/*/src/**/*",
      "backend-demo/build/libs/*.jar",
      "monaco-gherkin.json"
    ],
    "extraResources": [
      {
        "from": "apps/web/src/assets",
        "to": "assets",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}